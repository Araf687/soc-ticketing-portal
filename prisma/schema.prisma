generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// For User Access
enum UserLevel {
  L1
  L2
  L3

  @@map("user_level")
}

enum UserStatus {
  active
  inactive
  suspended

  @@map("user_status")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  passwordHash String     @map("password_hash")
  userLevel    UserLevel  @map("user_level")
  status       UserStatus @default(active) @map("status")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEnc String?    @map("mfa_secret_enc")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamp(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  roles                 UserRole[]
  teams                 TeamMember[]
  sessions              UserSession[]
  addedSuppressionRules SuppressionRule[]
  ledIncidents          Incident[]
  assignedTickets       Ticket[]          @relation("TicketAssignee")
  createdTickets        Ticket[]          @relation("TicketCreatedBy")
  ticketEvents          TicketEvent[]
  comments              Comment[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Team {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String     @unique
  teamLevel UserLevel? @map("team_level")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  members TeamMember[]
  tickets Ticket[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id])

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model UserSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ----------------------------------------------------------------------------------------------------------------

// For Asset Management
enum AssetCriticality {
  low
  medium
  high
  critical

  @@map("asset_criticality")
}

enum AgentStatus {
  active
  disconnected
  pending
  never_connected

  @@map("agent_status")
}

model Asset {
  id            String      @id @default(uuid(7)) @db.Uuid
  wazuhAgentId  String?     @unique @map("wazuh_agent_id")
  ipAddress     String?     @map("ip_address") @db.Inet
  name          String
  description   String?
  hostname      String?
  osName        String?     @map("os_name")
  osVersion     String?     @map("os_version")
  agentVersion  String?     @map("agent_version")
  agentStatus   AgentStatus @default(active) @map("agent_status")
  lastKeepAlive DateTime?   @map("last_keep_alive") @db.Timestamp(6)

  ownerUserName  String?          @map("owner_user_name")
  ownerUserEmail String?          @map("owner_user_email")
  department     String?          @map("department")
  location       String?          @map("location")
  criticality    AssetCriticality @default(medium)
  tags           String[]         @default([]) @map("tags")
  notes          String?          @map("notes")
  groupId        String?          @map("group_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

  assetGroup       AssetGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  suppressionRules SuppressionRule[]
  tickets          Ticket[]
  alerts           Alert[]

  @@index([hostname, ipAddress])
  @@map("assets")
}

model AssetGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  assets Asset[]

  @@map("asset_groups")
}

// ticket configuration
model SuppressionRule {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  matchFilter Json      @map("match_filter") @db.JsonB //{ruleId,agent id, source ip, rule group}
  reason      String
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  hitCount    Int       @default(0) @map("hit_count")
  isEnabled   Boolean   @default(true) @map("is_enabled")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  assetId     String? @db.Uuid
  createdById String? @map("created_by") @db.Uuid

  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  asset     Asset? @relation(fields: [assetId], references: [id])

  @@map("suppression_rules")
}

model Playbook {
  id              String          @id @default(uuid(7)) @db.Uuid
  name            String          @unique
  description     String?
  defaultPriority TicketPriority? @map("default_priority")
  matchFilter     Json            @map("match_filter") @db.JsonB //{rule group, min level ,agent id}  
  isEnabled       Boolean         @default(true) @map("is_enabled")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  playbookSteps PlaybookStep[]
  tickets       Ticket[]

  @@map("playbooks")
}

model PlaybookStep {
  id           String   @id @default(uuid(7)) @db.Uuid
  playbookId   String   @map("playbook_id") @db.Uuid
  orderNo      Int      @map("order_no")
  title        String
  instructions String
  isRequired   Boolean  @default(true) @map("is_required")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
  @@map("playbook_steps")
}

model GroupingRule {
  id                 String   @id @default(uuid(7)) @db.Uuid
  name               String
  description        String?
  matchFilter        Json     @map("match_filter") @db.JsonB //{rule group, min level ,agent id} 
  keyField           String[] @map("key_field")
  orderNo            Int      @map("order_no")
  windowMinutes      Int      @default(60) @map("window_minutes")
  autoTicketMinLevel Int?     @map("auto_ticket_min_level")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tickets Ticket[]

  @@map("grouping_rules")
}

model SlaPolicy {
  id                String   @id @default(uuid(7)) @db.Uuid
  TicketPriority    String   @unique
  ackMinutes        Int?     @map("ack_minutes")
  resolveMinutes    Int?     @map("resolve_minutes")
  businessHoursOnly Boolean  @default(false) @map("business_hours_only")
  escalateOnBreach  Boolean  @default(false) @map("escalate_on_breach")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sla_policies")
}

// ----------------------------------------------------------------------------------------------------------------
// Ticket and Alert Management

enum TicketPriority {
  P1
  P2
  P3
  P4

  @@map("ticket_priority")
}

enum TicketSeverity {
  very_low // level 0–5
  medium // level 6–8
  high // level 9–15

  @@map("ticket_severity")
}

enum TicketStatus {
  new // system banalo, keu dhore ni
  assigned // karo naame deoa hoyeche
  in_progress // analyst kaj shuru koreche
  escalated // upor level (L2/L3) e pathano hoyeche
  on_hold // opekkha (jemon IT team er uttor) — SLA clock pause
  resolved // analyst bolche shomadhan hoyeche
  closed // final, review shesh
  false_positive // ashol attack chilo na
  merged // onno ticket e merge hoye geche

  @@map("ticket_status")
}

enum TicketSource {
  auto // system banalo (alert grouping theke)
  promoted // ticket chara alert theke analyst banalo
  manual // analyst alert chara nijei banalo

  @@map("ticket_source")
}

enum ResolutionCode {
  true_positive
  benign
  false_positive
  duplicate

  @@map("resolution_code")
}

enum AlertStatus {
  new // saved, not in a ticket (level too low)
  linked // in a ticket
  ignored // hidden by a suppression rule
  false_positive // marked by an analyst

  @@map("alert_status")
}

enum TicketCategory {
  brute_force
  malware
  phishing
  policy_violation
  misconfiguration
  other

  @@map("ticket_category")
}

model Incident {
  id         String         @id @default(uuid()) @db.Uuid
  number     BigInt         @unique
  title      String
  summary    String?
  severity   TicketSeverity
  status     TicketStatus   @default(new)
  leadUserId String?        @map("lead_user_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamp

  leadUser User?    @relation(fields: [leadUserId], references: [id], onDelete: SetNull)
  tickets  Ticket[]
}

model Ticket {
  id          String          @id @default(uuid(7)) @db.Uuid
  number      Int             @unique @default(autoincrement()) // #1001, #1002 ...
  title       String
  description String?
  status      TicketStatus    @default(new)
  priority    TicketPriority  @default(P3)
  severity    TicketSeverity  @default(medium)
  source      TicketSource    @default(auto)
  tier        UserLevel       @default(L1)
  category    TicketCategory?

  // grouping
  groupingRuleId  String?  @map("grouping_rule_id") @db.Uuid
  groupingKey     String?  @map("grouping_key")
  alertCount      Int      @default(0) @map("alert_count")
  maxRuleLevel    Int?     @map("max_rule_level") @db.SmallInt
  mitreTactics    String[] @default([]) @map("mitre_tactics")
  mitreTechniques String[] @default([]) @map("mitre_techniques")
  tags            String[] @default([])

  // relations
  primaryAssetId String? @map("primary_asset_id") @db.Uuid
  assigneeId     String? @map("assignee_id") @db.Uuid
  teamId         String? @map("team_id") @db.Uuid
  createdById    String? @map("created_by") @db.Uuid // null = system
  incidentId     String? @map("incident_id") @db.Uuid
  playbookId     String? @map("playbook_id") @db.Uuid
  mergedIntoId   String? @map("merged_into_id") @db.Uuid

  // timestamps for metrics (MTTD / MTTA / MTTR)
  firstAlertAt   DateTime? @map("first_alert_at") @db.Timestamptz
  lastAlertAt    DateTime? @map("last_alert_at") @db.Timestamptz
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz
  escalatedAt    DateTime? @map("escalated_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // outcome
  resolutionCode ResolutionCode? @map("resolution_code")
  resolutionNote String?         @map("resolution_note")

  groupingRule GroupingRule? @relation(fields: [groupingRuleId], references: [id], onDelete: SetNull)
  primaryAsset Asset?        @relation(fields: [primaryAssetId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  incident     Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  playbook     Playbook?     @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  mergedInto   Ticket?       @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Ticket[]      @relation("TicketMerge")
  alerts       Alert[]
  events       TicketEvent[]
  comments     Comment[]

  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([teamId, status])
  @@index([groupingRuleId, groupingKey, status])
  @@index([primaryAssetId])
  @@index([incidentId])
  @@index([createdAt(sort: Desc)])
  @@map("tickets")
}

model Alert {
  id           String      @id @default(uuid(7)) @db.Uuid
  wazuhAlertId String      @unique @map("wazuh_alert_id") // same alert is never saved twice
  assetId      String?     @map("asset_id") @db.Uuid
  ticketId     String?     @map("ticket_id") @db.Uuid
  status       AlertStatus @default(new)

  // copied from the Wazuh JSON
  ruleId          String    @map("rule_id")
  ruleLevel       Int       @map("rule_level") @db.SmallInt
  ruleDescription String?   @map("rule_description")
  ruleGroups      String[]  @default([]) @map("rule_groups")
  mitreTactics    String[]  @default([]) @map("mitre_tactics")
  mitreTechniques String[]  @default([]) @map("mitre_techniques")
  agentId         String?   @map("agent_id")
  agentName       String?   @map("agent_name")
  srcIp           String?   @map("src_ip") @db.Inet
  dstIp           String?   @map("dst_ip") @db.Inet
  srcUser         String?   @map("src_user")
  dstUser         String?   @map("dst_user")
  location        String? // log source path
  eventTime       DateTime? @map("event_time") @db.Timestamptz // when it happened
  alertTime       DateTime  @map("alert_time") @db.Timestamptz // Wazuh "timestamp"
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  groupingKey     String?   @map("grouping_key")
  raw             Json // full Wazuh alert

  asset  Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([status, alertTime(sort: Desc)])
  @@index([ticketId])
  @@index([assetId, alertTime(sort: Desc)])
  @@index([ruleId, alertTime(sort: Desc)])
  @@map("alerts")
}

// -----------------------------------------------------------

enum TicketEventType {
  created
  alert_linked
  status_changed
  assigned
  priority_changed
  severity_changed
  escalated
  commented
  merged
  merged_from
  linked
  playbook_attached
  task_completed
  sla_breached
  reopened

  @@map("ticket_event_type")
}

model TicketEvent {
  id        BigInt          @id @default(autoincrement())
  ticketId  String          @map("ticket_id") @db.Uuid
  actorId   String?         @map("actor_id") @db.Uuid // null = system
  eventType TicketEventType @map("event_type")
  oldValue  Json?           @map("old_value")
  newValue  Json?           @map("new_value")
  note      String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([eventType, createdAt])
  @@map("ticket_events")
}

model Comment {
  id         String    @id @default(uuid(7)) @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  authorId   String?   @map("author_id") @db.Uuid
  body       String
  isInternal Boolean   @default(true) @map("is_internal")
  editedAt   DateTime? @map("edited_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("comments")
}
